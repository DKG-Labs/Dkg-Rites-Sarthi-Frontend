{
  "routes": [
    {
      "route": "/sleeper/assets/*"
    },
    {
      "route": "/sleeper*",
      "rewrite": "/sleeper/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/sleeper/assets/*",
      "/assets/*",
      "/images/*",
      "/css/*",
      "/js/*"
    ]
  }
}
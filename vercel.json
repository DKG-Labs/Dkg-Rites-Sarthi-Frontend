{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "headers": [
    {
      "source": "/(index.html|version.json|sleeper/index.html|railpad/index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sleeper|railpad)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/scada-proxy/api/scada/scada",
      "dest": "https://scada.ritesqasarthi.com/api/scada/scada"
    },
    {
      "src": "/scada-proxy/api/scada/scada-data",
      "dest": "https://scada.ritesqasarthi.com/api/scada/scada-data"
    },
    {
      "src": "/sleeper/(.*)",
      "dest": "/sleeper/index.html"
    },
    {
      "src": "/railpad/(.*)",
      "dest": "/railpad/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}